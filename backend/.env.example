# =====================================================================
# AI数字化人才平台 - 环境配置模板
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# ⚠️ 本文件为占位值，真实 .env 已被 .gitignore 排除，切勿提交真实密钥
# =====================================================================

# ── 应用基础 ──
APP_NAME=AI数字化人才平台
APP_VERSION=1.0.0
DEBUG=true
# 生产部署请改为 false（关闭热重载；异常堆栈已不随 DEBUG 回传，见 main.py）

# ── 服务器 ──
HOST=0.0.0.0
PORT=8003
WORKERS=1
KEEP_ALIVE=60

# ── CORS（生产改为真实前端域名，勿用通配符）──
# CORS_ORIGINS 为 JSON 数组，示例：["http://localhost:8080"]

# ── JWT 认证 ──
# ⚠️ SECRET_KEY 必须替换为强随机串（生产禁止用默认值）
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 安全策略 ──
# 是否开放游客自助注册（默认 false，账号由管理员后台创建）
ALLOW_SELF_REGISTER=false

# ── MySQL（业务主数据）──
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=digital_talent

# ── PostgreSQL（海量分析宽表）──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=talent_analytics

# ── Redis（缓存/会话/限流）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Milvus（向量库）──
MILVUS_URI=http://localhost:19530
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB=default
MILVUS_COLLECTION=talent_vectors
MILVUS_COLLECTION_TALENT=talent_resume
MILVUS_COLLECTION_JOB=job_position
MILVUS_COLLECTION_KNOWLEDGE=knowledge_base
EMBEDDING_DIM=1024

# ── 文件上传 ──
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads
MEDIA_ROOT=./media
MEDIA_URL=/media

# ── MinIO 对象存储（宿主机 9100=API / 9101=Console）──
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=resumes
MINIO_SECURE=false

# ── 日志 ──
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── AI / LLM ──
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:1.7b
EMBEDDING_MODEL=bge-m3:latest
# LLM 策略：ollama | silicon_flow
LLM_STRATEGY=ollama

# ── SiliconFlow（简历解析/NL2SQL 高精度任务）──
SILICON_FLOW_API_KEY=
SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICON_FLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ── Dify 中台（AI 应用中台，5 大智能体 workflow）──
DIFY_ENABLED=false
DIFY_API_BASE=http://localhost/v1
DIFY_API_KEY=
DIFY_APP_MODE=workflow
DIFY_APP_KEY_RESUME=
DIFY_APP_KEY_ASSESSMENT=
DIFY_APP_KEY_MATCHING=
DIFY_APP_KEY_TRAINING=
DIFY_APP_KEY_DATA_DECISION=
DIFY_BACKEND_TOKEN=
