            <rect x='350' y='300' width='180' height='62' rx='6' fill='#FFFFFF' stroke='#08A6F6' strokeWidth='2' />
            <text x='440' y='324' textAnchor='middle' fill='#061F32' fontSize='17' fontWeight='bold'>培训赋能智能体</text>
