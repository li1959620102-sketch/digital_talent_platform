        <line x1='0' y1='440' x2='1280' y2='440' />
      </g>
      <g fill='none' stroke='#08A6F6' strokeWidth='1.5'>
        <circle cx='1040' cy='150' r='70' />
        <circle cx='1040' cy='150' r='110' opacity='0.5' />
        <circle cx='1040' cy='150' r='150' opacity='0.3' />
      </g>
