    </Box>
    <Box style={{ marginBottom: 8 }}>
      <Text style={{ fontSize: 34, color: '#061F32', fontWeight: 'bold', lineHeight: 1.3 }}>13 项 P0 功能，十项验收标准全齐</Text>
    </Box>
    <Box style={{ width: 1160, height: 1, background: '#061F32', marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', flex: 1, gap: 40 }}>
      {/* 左：功能技术落地 */}
      <Box style={{ flex: 5, flexDirection: 'column' }}>
        <Text style={{ fontSize: 22, color: '#061F32', fontWeight: 'bold', marginBottom: 14 }}>代表性功能 · 技术落地</Text>
        <Box style={{ flexDirection: 'column', gap: 12 }}>
          {[
            ['人才智能档案', 'AI 简历解析 → 智能标签 → 人才画像 → 语义检索'],
