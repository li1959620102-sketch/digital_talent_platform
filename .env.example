# =====================================================================
# docker-compose.yml 变量替换模板
# 复制为项目根目录 .env 并填入真实值：cp .env.example .env
# 注意：本文件是「项目根目录」的 .env，与 backend/.env（应用运行时配置）是两个不同文件：
#   - 根目录 .env      → 供 docker compose 做 ${VAR} 变量替换
#   - backend/.env     → 供 FastAPI 应用读取（本地直跑后端时使用）
# =====================================================================

# JWT 签名密钥（必填，生产环境禁止使用示例值）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64

# 首次启动管理员（必填；至少 12 位，部署后立即轮换）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_use_a_strong_unique_password

# HTTPS 生产环境必须为 true；仅本机纯 HTTP 调试时可设为 false
AUTH_COOKIE_SECURE=true

# 生产前端真实来源，必须是 JSON 数组且使用 HTTPS
CORS_ORIGINS=["https://talent.example.com"]

# 基础设施凭据（生产环境必须使用独立随机值）
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_password
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
REDIS_PASSWORD=CHANGE_ME_redis_password
