# =====================================================================
# HTTPS 站点配置模板（生产环境）
#
# 本文件是 docker/nginx/conf.d/default.conf 的「HTTPS 完整替换版」。
# 未启用 HTTPS 前请保持 .example 后缀（nginx 只加载 conf.d/*.conf，不会读到它）。
#
# 启用步骤：
#   1) 证书放到 docker/nginx/ssl/，文件名 fullchain.pem 与 privkey.pem；
#   2) cd docker/nginx/conf.d
#      mv default.conf default.conf.disabled      # 停用仅 http 的旧配置
#      cp https.conf.example https.conf           # 本模板转为生效配置
#      并把下文的 talent.example.com 全部换成你的真实域名；
#   3) 取消 docker-compose.prod.yml 中 nginx 的 ports / volumes 注释；
#   4) docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#      docker exec digital_talent_nginx nginx -t     # 校验语法
#   5) 后端环境变量需同步：AUTH_COOKIE_SECURE=true、CORS_ORIGINS=["https://你的域名"]
# =====================================================================

upstream backend_upstream {
    server backend:8000;
    keepalive 32;
}

# ── 80：仅做 ACME 校验与强制跳转 HTTPS ────────────────────────────────
server {
    listen 80;
    server_name talent.example.com;

    # Let's Encrypt 续期校验路径不能跳转
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── 443：正式入口 ─────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name talent.example.com;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    root /usr/share/nginx/html;
    index index.html;

    # 登录接口更严格的速率限制（zone 定义在 nginx.conf 的 http 块）
    location = /api/v1/auth/login {
        limit_req zone=login_limit burst=5 nodelay;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # AI 推理类接口：本地 CPU 推理单次可达成百秒级，放宽读超时，
    # 避免「网关已 504、服务端仍在跑并把结果写库」的状态不一致。
    location ~ ^/api/v1/(talents/parse-resume|matching/|agents/|knowledge/(qa|search|vectorize)) {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        client_max_body_size 50m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 普通业务接口
    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        client_max_body_size 50m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 前端 SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
